# ==============================================================================
# STARBOUND OUTPOST - MISSION CONFIGURATION & CREDENTIALS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NASA OPEN API KEY (Live Space Weather & Solar Telemetry)
# ------------------------------------------------------------------------------
# Obtain your free API key at: https://api.nasa.gov
# Paste your 40-character key below.
# If left as default, Starbound Outpost automatically uses the authentic
# NASA DONKI offline scientific snapshot dataset with zero downtime.
NASA_API_KEY="ENTER YOUR KEY"

# ------------------------------------------------------------------------------
# 2. GEMINI AI API KEY (Optional AI Mission Advisor / Capcom Dialogue)
# ------------------------------------------------------------------------------
# Obtain your key at: https://aistudio.google.com/app/apikey
# If unset, Starbound Outpost uses the built-in deterministic NASA engineering
# calculations and flight director tactical rule engine.
GEMINI_API_KEY="ENTER YOUR KEY"

# ------------------------------------------------------------------------------
# 3. GEMINI MODEL CONFIGURATION
# ------------------------------------------------------------------------------
GEMINI_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
